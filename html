<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TrafficVision • Orange County, CA</title>

    <!-- Leaflet CSS — loaded early, HTTPS only -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        /* ——— RESET & FULL HEIGHT ——— */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            height: 100%;
            width: 100%;
            background: #0b0e14;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #e8edf5;
            overflow: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* ——— TOP BAR ——— */
        .topbar {
            background: #141a24;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            border-bottom: 1px solid #2a3340;
            flex-wrap: wrap;
            gap: 10px;
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            white-space: nowrap;
        }
        .brand span {
            color: #5fc3ff;
        }
        .badge {
            background: #1f2a37;
            padding: 2px 12px;
            border-radius: 40px;
            font-size: 0.65rem;
            color: #8fa3bf;
            border: 1px solid #2f3d4f;
        }

        .search-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 1 1 280px;
            max-width: 420px;
        }
        .search-wrap input {
            flex: 1;
            padding: 6px 14px;
            border-radius: 40px;
            border: 1px solid #2a3340;
            background: #0b0e14;
            color: #e8edf5;
            font-size: 0.85rem;
            outline: none;
            min-width: 100px;
        }
        .search-wrap input:focus {
            border-color: #5fc3ff;
            box-shadow: 0 0 0 2px rgba(95, 195, 255, 0.15);
        }
        .search-wrap input::placeholder {
            color: #5f738f;
        }
        .search-wrap button {
            background: #1f2a37;
            border: none;
            color: #e8edf5;
            padding: 6px 16px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.8rem;
            cursor: pointer;
            border: 1px solid #2a3340;
            white-space: nowrap;
        }
        .search-wrap button:hover {
            background: #2f3d4f;
        }

        .stats {
            font-size: 0.75rem;
            color: #8fa3bf;
            white-space: nowrap;
        }

        /* ——— MAP CONTAINER ——— */
        #map {
            flex: 1;
            width: 100%;
            min-height: 0;
            /* critical for flex children */;
            background: #0b0e14;
        }

        /* ——— LOADING OVERLAY ——— */
        #loading {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #0b0e14;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            color: #8fa3bf;
            font-size: 0.9rem;
            transition: opacity 0.6s ease;
        }
        #loading.hidden {
            opacity: 0;
            pointer-events: none;
        }
        #loading .spinner {
            width: 32px;
            height: 32px;
            border: 3px solid #1f2a37;
            border-top-color: #5fc3ff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 16px;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ——— LEAFLET OVERRIDES ——— */
        .leaflet-control-zoom a {
            background: #141a24 !important;
            color: #e8edf5 !important;
            border-color: #2a3340 !important;
        }
        .leaflet-control-zoom a:hover {
            background: #1f2a37 !important;
        }
        .leaflet-popup-content-wrapper {
            background: #141a24 !important;
            color: #e8edf5 !important;
            border-radius: 10px !important;
            border: 1px solid #2a3340;
        }
        .leaflet-popup-tip {
            background: #141a24 !important;
        }
        .leaflet-popup-content {
            font-size: 0.8rem;
            line-height: 1.5;
            min-width: 140px;
        }
        .leaflet-popup-content strong {
            color: #5fc3ff;
        }

        /* ——— RESPONSIVE ——— */
        @media (max-width: 650px) {
            .topbar {
                flex-direction: column;
                align-items: stretch;
                padding: 10px 14px;
            }
            .search-wrap {
                max-width: 100%;
            }
            .stats {
                text-align: right;
            }
        }
    </style>
</head>
<body>

    <!-- ——— LOADING OVERLAY ——— -->
    <div id="loading">
        <div class="spinner"></div>
        <span>Loading cameras…</span>
    </div>

    <!-- ——— TOP BAR ——— -->
    <header class="topbar">
        <div class="brand">
            <span>🚦</span> Traffic<span>Vision</span>
            <span class="badge">live</span>
        </div>

        <div class="search-wrap">
            <input type="text" id="searchInput" placeholder="Search road, city, or ID…" />
            <button id="searchBtn">Search</button>
        </div>

        <div class="stats" id="cameraCount">Loading…</div>
    </header>

    <!-- ——— MAP ——— -->
    <div id="map"></div>

    <!-- ——— LEAFLET JS ——— -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script>
        // ───────────────────────────────────────────────
        //  WAIT FOR DOM + LEAFLET
        // ───────────────────────────────────────────────

        (function init() {
            // If Leaflet didn't load, show error
            if (typeof L === 'undefined') {
                document.getElementById('loading').innerHTML = `
                            <div style="color:#ff6b6b;font-size:1.4rem;margin-bottom:12px;">⚠️</div>
                            <span style="color:#ff6b6b;">Leaflet failed to load.</span>
                            <span style="font-size:0.75rem;color:#5f738f;margin-top:8px;">Check your internet connection.</span>
                        `;
                return;
            }

            // ─── DATA ──────────────────────────────────
            const cameras = [
                // Santa Ana
                { id: 'SA-01', name: 'I-5 @ 17th St', lat: 33.7485, lng: -117.8689, road: 'I-5' },
                { id: 'SA-02', name: 'SR-22 @ Main St', lat: 33.7498, lng: -117.8665, road: 'SR-22' },

                // Orange
                { id: 'OR-01', name: 'SR-57 @ Chapman Ave', lat: 33.7873, lng: -117.8531, road: 'SR-57' },
                { id: 'OR-02', name: 'I-5 @ Tustin St', lat: 33.7870, lng: -117.8250, road: 'I-5' },

                // Anaheim
                { id: 'AN-01', name: 'I-5 @ Disneyland Dr', lat: 33.8090, lng: -117.9190, road: 'I-5' },
                { id: 'AN-02', name: 'SR-91 @ Harbor Blvd', lat: 33.8345, lng: -117.9145, road: 'SR-91' },
                { id: 'AN-03', name: 'I-5 @ Katella Ave', lat: 33.8030, lng: -117.8880, road: 'I-5' },

                // Irvine
                { id: 'IR-01', name: 'I-405 @ Jamboree Rd', lat: 33.6680, lng: -117.8550, road: 'I-405' },
                { id: 'IR-02', name: 'SR-133 @ Irvine Blvd', lat: 33.6870, lng: -117.8270, road: 'SR-133' },

                // Huntington Beach
                { id: 'HB-01', name: 'SR-1 @ Beach Blvd', lat: 33.6600, lng: -117.9990, road: 'SR-1' },
                { id: 'HB-02', name: 'I-405 @ Goldenwest St', lat: 33.7100, lng: -118.0150, road: 'I-405' },

                // Fullerton
                { id: 'FU-01', name: 'SR-91 @ State College Blvd', lat: 33.8700, lng: -117.8910, road: 'SR-91' },

                // Garden Grove
                { id: 'GG-01', name: 'SR-22 @ Euclid St', lat: 33.7750, lng: -117.9450, road: 'SR-22' },

                // Costa Mesa
                { id: 'CM-01', name: 'I-405 @ Harbor Blvd', lat: 33.6640, lng: -117.9140, road: 'I-405' },

                // Newport Beach
                { id: 'NB-01', name: 'SR-1 @ Newport Blvd', lat: 33.6270, lng: -117.9310, road: 'SR-1' },

                // Mission Viejo
                { id: 'MV-01', name: 'I-5 @ Oso Pkwy', lat: 33.5870, lng: -117.6680, road: 'I-5' },

                // Rancho Santa Margarita
                { id: 'RSM-01', name: 'SR-241 @ Santa Margarita', lat: 33.6430, lng: -117.5750, road: 'SR-241' },
            ];

            // ─── MAP ──────────────────────────────────
            const map = L.map('map', {
                center: [33.75, -117.90],
                zoom: 11,
                zoomControl: true,
            });

            // Tile layer — HTTPS only
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, &copy; CartoDB',
                subdomains: 'abcd',
                maxZoom: 19,
            }).addTo(map);

            // ─── MARKERS ──────────────────────────────
            const markers = [];

            cameras.forEach(cam => {
                const marker = L.circleMarker([cam.lat, cam.lng], {
                    radius: 7,
                    fillColor: '#5fc3ff',
                    color: '#1f2a37',
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 0.85,
                })
                    .addTo(map)
                    .bindPopup(`
                                <strong>${cam.name}</strong><br />
                                Road: ${cam.road}<br />
                                ID: ${cam.id}<br />
                                <span style="color:#5fc3ff;font-size:0.7rem;">● live</span>
                            `);

                markers.push({ marker, data: cam });
            });

            // ─── UPDATE COUNTER ──────────────────────
            document.getElementById('cameraCount').textContent = `${cameras.length} cameras`;

            // ─── SEARCH ──────────────────────────────
            function performSearch(query) {
                const q = query.trim().toLowerCase();
                if (!q) {
                    map.setView([33.75, -117.90], 11);
                    return;
                }

                const found = markers.filter(({ data }) =>
                    data.name.toLowerCase().includes(q) ||
                    data.road.toLowerCase().includes(q) ||
                    data.id.toLowerCase().includes(q)
                );

                if (found.length === 0) {
                    alert(`No cameras found for "${query}"`);
                    return;
                }

                const first = found[0];
                map.setView([first.data.lat, first.data.lng], 13);
                first.marker.openPopup();
            }

            document.getElementById('searchBtn').addEventListener('click', () =>
                performSearch(document.getElementById('searchInput').value)
            );
            document.getElementById('searchInput').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') performSearch(e.target.value);
            });

            // ─── HIDE LOADING ─────────────────────────
            setTimeout(() => {
                document.getElementById('loading').classList.add('hidden');
            }, 400);

            // ─── RESIZE SAFETY ────────────────────────
            setTimeout(() => map.invalidateSize(), 600);

            // ─── LOG ──────────────────────────────────
            console.log(`🚦 TrafficVision · ${cameras.length} cameras loaded`);

        })();
    </script>

</body>
</html>
